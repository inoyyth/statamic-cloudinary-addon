{
    "name": "inoyyth/statamic-cloudinary",
    "description": "Statamic Cloudinary integration: Flysystem adapter for Asset Containers, direct upload services, Antlers tags, and image resolution helpers.",
    "type": "statamic-addon",
    "keywords": [
        "statamic",
        "statamic-addon",
        "cloudinary",
        "flysystem",
        "assets",
        "cms"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/inoyyth/statamic-cloudinary-addon/issues",
        "source": "https://github.com/inoyyth/statamic-cloudinary-addon"
    },
    "authors": [
        {
            "name": "Inoyyth",
            "email": "supri170845@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "cloudinary/cloudinary_php": "^2.0",
        "illuminate/filesystem": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "league/flysystem": "^3.0",
        "statamic/cms": "^5.0 || ^6.0",
        "symfony/mime": "^6.0 || ^7.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Inoyyth\\StatamicCloudinary\\": "src/"
        },
        "files": [
            "src/Support/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Inoyyth\\StatamicCloudinary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Cloudinary",
            "description": "Cloudinary Flysystem driver for Statamic Asset Containers, media delivery, and image resolution tools."
        },
        "laravel": {
            "providers": [
                "Inoyyth\\StatamicCloudinary\\ServiceProvider"
            ],
            "aliases": {
                "StatamicImage": "Inoyyth\\StatamicCloudinary\\Facades\\StatamicImage",
                "Cloudinary": "Inoyyth\\StatamicCloudinary\\Facades\\Cloudinary"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}